(unless (boundp 'mx-machina-test-root)
  (load (expand-file-name "mx-machina-tests.el" (file-name-directory (or load-file-name buffer-file-name))) nil t))
(require 'mx-machina-recovery)

(ert-deftest mx-machina-recovery-accept-branch-preserves-identity-and-files ()
  (mx-machina-test-with-store
    (let* ((id (mx-machina-create "Retain identity" repo "account-profile" "Work/Project"))
           (run (mx-machina--begin-run id))
           (file (expand-file-name "draft" repo)))
      (mx-machina--observe id run "failed" "unknown" "original-conversation" "Previous failure")
      (mx-machina--exec "UPDATE sessions SET unread=1,model='known-model' WHERE id=?" id)
      (write-region "unsaved work" nil file nil 'silent)
      (mx-machina--git repo "checkout" "-b" "new-branch")
      (let* ((before (mx-machina-session id))
             (expected (copy-mx-machina-session before))
             (runs (mx-machina--query "SELECT * FROM runs"))
             (head (mx-machina--git repo "rev-parse" "HEAD"))
             (dirty (mx-machina--git repo "status" "--porcelain")))
        (setf (mx-machina-session-branch expected) "new-branch")
        (cl-letf (((symbol-function 'yes-or-no-p)
                   (lambda (prompt)
                     (should (string-match-p "Recorded:.*\\[main\\]" prompt))
                     (should (string-match-p "Proposed:.*\\[new-branch\\]" prompt))
                     (should (equal before (mx-machina-session id))) t))
                  ((symbol-function 'mx-machina-backend-start) (lambda (&rest _) (ert-fail "Recovery launched an agent"))))
          (mx-machina-rebind-worktree id repo))
        (should (equal expected (mx-machina-session id)))
        (should (equal runs (mx-machina--query "SELECT * FROM runs")))
        (should (equal head (mx-machina--git repo "rev-parse" "HEAD")))
        (should (equal dirty (mx-machina--git repo "status" "--porcelain")))
        (mx-machina-store-close)
        (should (equal expected (mx-machina-session id)))))))

(ert-deftest mx-machina-recovery-relocated-linked-worktree-and-shell-draft ()
  (mx-machina-test-with-store
    (let* ((old (expand-file-name "old-checkout" temporary))
           (new (expand-file-name "moved-checkout" temporary))
           (id (mx-machina-create-worktree "Moved" repo "test" "agent/work" old))
           (shell (mx-machina-eshell id)))
      (insert "echo unsent draft")
      (let ((draft (buffer-string)) (shell-directory default-directory))
        (mx-machina--git repo "worktree" "move" old new)
        (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
          (mx-machina-rebind-worktree id new))
        (should-not (file-exists-p old))
        (should (equal (mx-machina-session-directory (mx-machina-session id))
                       (file-name-as-directory (file-truename new))))
        (should (equal (mx-machina-session-project (mx-machina-session id)) "worktree"))
        (with-current-buffer shell
          (should (equal draft (buffer-string)))
          (should (equal shell-directory default-directory))
          (should-not mx-machina--shell-id))
        (unwind-protect
            (let ((new-shell (mx-machina-eshell id)))
              (should-not (eq shell new-shell))
              (should (file-equal-p default-directory new))
              (set-buffer-modified-p nil)
              (kill-buffer new-shell))
          (with-current-buffer shell (set-buffer-modified-p nil))
          (kill-buffer shell))))))

(ert-deftest mx-machina-recovery-cancel-cold-registry-and-invalid-target ()
  (mx-machina-test-with-store
    (let* ((id (mx-machina-create "Cancel" repo "test"))
           (other (mx-machina-create "Other live observation" repo "test"))
           (run (mx-machina--begin-run other)))
      (mx-machina--observe other run "live" "working" "other-conversation")
      (mx-machina--git repo "checkout" "-b" "changed")
      (let ((sessions (mx-machina--query "SELECT * FROM sessions"))
            (runs (mx-machina--query "SELECT * FROM runs")))
        (mx-machina-store-close)
        (cl-letf (((symbol-function 'mx-machina-store-open) (lambda () (ert-fail "Cancelled recovery opened registry")))
                  ((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
          (should-error (mx-machina-rebind-worktree id repo) :type 'user-error)
          (should-error (mx-machina-rebind-worktree id (expand-file-name "missing" temporary)) :type 'user-error)
          (should-error (mx-machina-rebind-worktree id temporary) :type 'user-error)
          (should-error (mx-machina-rebind-worktree id "/ssh:fixture:/repo/") :type 'user-error)
          (cl-letf (((symbol-function 'read-directory-name) (lambda (&rest _) (signal 'quit nil))))
            (should (eq (condition-case nil (mx-machina-rebind-worktree id) (quit 'cancelled)) 'cancelled))))
        (should-not mx-machina--db)
        (let ((db (sqlite-open (expand-file-name "sessions.sqlite" mx-machina-directory))))
          (unwind-protect
              (progn (should (equal sessions (sqlite-select db "SELECT * FROM sessions")))
                     (should (equal runs (sqlite-select db "SELECT * FROM runs"))))
            (sqlite-close db)))))))

(ert-deftest mx-machina-recovery-rejects-starting-tracked-and-lingering-process ()
  (mx-machina-test-with-store
    (let* ((id (mx-machina-create "Busy" repo "test"))
           (run (mx-machina--begin-run id))
           (buffer (generate-new-buffer "*Recovery process*"))
           (process (make-pipe-process :name "recovery-fixture" :buffer buffer :noquery t)))
      (unwind-protect
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) (ert-fail "Running agents must be rejected before confirmation"))))
            (should-error (mx-machina-rebind-worktree id repo) :type 'user-error)
            (mx-machina--observe id run "stopped" "unknown" "saved-id")
            (puthash id (cons run (mx-machina--transport-create :buffer buffer)) mx-machina--running)
            (should-error (mx-machina-rebind-worktree id repo) :type 'user-error)
            (remhash id mx-machina--running)
            (with-current-buffer buffer
              (setq mx-machina--managed-id id mx-machina--backend-kind 'eat))
            (should-error (mx-machina-rebind-worktree id repo) :type 'user-error)
            (with-current-buffer buffer
              (setq mx-machina--backend-kind 'agent-shell)
              (setq-local agent-shell--state (list (cons :client (list (cons :process process))))))
            (should-error (mx-machina-rebind-worktree id repo) :type 'user-error)
            (should (process-live-p process)))
        (remhash id mx-machina--running)
        (delete-process process)
        (kill-buffer buffer)))))

(ert-deftest mx-machina-recovery-revalidates-confirmed-state ()
  (mx-machina-test-with-store
    (let ((id (mx-machina-create "Race" repo "test")))
      (mx-machina--git repo "checkout" "-b" "proposed")
      (cl-letf (((symbol-function 'yes-or-no-p)
                 (lambda (&rest _) (mx-machina--git repo "checkout" "-b" "changed-again") t)))
        (should-error (mx-machina-rebind-worktree id repo) :type 'user-error))
      (should (equal (mx-machina-session-branch (mx-machina-session id)) "main"))
      (cl-letf (((symbol-function 'yes-or-no-p)
                 (lambda (&rest _) (mx-machina-rename id "Renamed during prompt") t)))
        (should-error (mx-machina-rebind-worktree id repo) :type 'user-error))
      (should (equal (mx-machina-session-branch (mx-machina-session id)) "main"))
      (cl-letf (((symbol-function 'yes-or-no-p)
                 (lambda (&rest _) (mx-machina--begin-run id) t)))
        (should-error (mx-machina-rebind-worktree id repo) :type 'user-error))
      (should (equal (mx-machina-session-branch (mx-machina-session id)) "main")))))

(ert-deftest mx-machina-recovery-write-failure-rolls-back ()
  (mx-machina-test-with-store
    (let* ((id (mx-machina-create "Write failure" repo "test"))
           (before (mx-machina-session id))
           (execute (symbol-function 'mx-machina--exec)))
      (mx-machina--git repo "checkout" "-b" "proposed")
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                ((symbol-function 'mx-machina--exec)
                 (lambda (sql &rest values)
                   (prog1 (apply execute sql values)
                     (when (string-prefix-p "UPDATE sessions SET directory=" sql)
                       (error "Fixture write failure"))))))
        (should-error (mx-machina-rebind-worktree id repo)))
      (should (equal before (mx-machina-session id))))))

(ert-deftest mx-machina-recovery-ui-default-branch-and-noop ()
  (mx-machina-test-with-store
    (let ((id (mx-machina-create "Inspect and recover" repo "test")))
      (mx-machina--git repo "checkout" "-b" "accepted")
      (mx-machina-diagnostics id)
      (when (bound-and-true-p evil-mode) (evil-normal-state))
      (should (eq (key-binding (kbd "W")) #'mx-machina-rebind-worktree))
      (cl-letf (((symbol-function 'read-directory-name)
                 (lambda (_ directory &rest _) (should (file-equal-p directory repo)) directory))
                ((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
        (call-interactively (key-binding (kbd "W"))))
      (should (string-match-p "Recorded branch: accepted" (buffer-string)))
      (should-not (string-match-p "Worktree mismatch" (buffer-string)))
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) (ert-fail "No-op prompted")))
                ((symbol-function 'mx-machina--exec) (lambda (&rest _) (ert-fail "No-op wrote registry"))))
        (mx-machina-rebind-worktree id repo)))))


(ert-deftest mx-machina-retry-cancel-and-invalid-preconditions-do-not-write ()
  (mx-machina-test-with-store
    (let* ((id (mx-machina-create "Retry" repo "original"))
           (empty (mx-machina-create "Never launched" repo "original"))
           (run (mx-machina--begin-run id))
           (configs '(((:identifier . original) (:interface . eat) (:command . ("python3"))))))
      (mx-machina--observe id run "failed" "unknown" "original-id" "Authentication failed")
      (let ((sessions (mx-machina--query "SELECT * FROM sessions"))
            (runs (mx-machina--query "SELECT * FROM runs")))
        (mx-machina-store-close)
        (cl-letf (((symbol-function 'mx-machina-backend-configs) (lambda () configs))
                  ((symbol-function 'mx-machina-open) (lambda (&rest _) (ert-fail "Unexpected start")))
                  ((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
          (should-error (mx-machina-retry id) :type 'user-error)
          (should-error (mx-machina-retry empty) :type 'user-error)
          (setq configs '(((:identifier . similar-name) (:interface . eat))))
          (should-error (mx-machina-retry id) :type 'user-error)
          (should-not mx-machina--db)
          (let ((db (sqlite-open (expand-file-name "sessions.sqlite" mx-machina-directory))))
            (unwind-protect
                (progn (should (equal sessions (sqlite-select db "SELECT * FROM sessions")))
                       (should (equal runs (sqlite-select db "SELECT * FROM runs"))))
              (sqlite-close db))))))))

(ert-deftest mx-machina-retry-revalidates-profile-and-record ()
  (mx-machina-test-with-store
    (let* ((id (mx-machina-create "Retry" repo "original"))
           (run (mx-machina--begin-run id))
           (configs '(((:identifier . original) (:interface . eat) (:command . ("python3"))))))
      (mx-machina--observe id run "stopped" "unknown" "original-id")
      (cl-letf (((symbol-function 'mx-machina-backend-configs) (lambda () configs))
                ((symbol-function 'mx-machina-open) (lambda (&rest _) (ert-fail "Changed state launched"))))
        (cl-letf (((symbol-function 'yes-or-no-p)
                   (lambda (&rest _) (setq configs '(((:identifier . original) (:interface . vterm)))) t)))
          (should-error (mx-machina-retry id) :type 'user-error))
        (cl-letf (((symbol-function 'yes-or-no-p)
                   (lambda (&rest _) (mx-machina-rename id "Changed") t)))
          (should-error (mx-machina-retry id) :type 'user-error))
        (cl-letf (((symbol-function 'yes-or-no-p)
                   (lambda (&rest _) (mx-machina--begin-run id) t)))
          (should-error (mx-machina-retry id) :type 'user-error)))
      (should (equal "original-id" (mx-machina-session-conversation (mx-machina-session id)))))))

(ert-deftest mx-machina-retry-ui-and-guidance-do-not-expose-payloads ()
  (mx-machina-test-with-store
    (let* ((id (mx-machina-create "Retry" repo "original"))
           (run (mx-machina--begin-run id))
           (config '((:identifier . original) (:interface . eat) (:command . ("python3" "SECRET-ARGV")))))
      (mx-machina--observe id run "stopped" "unknown" "original-id")
      (cl-letf (((symbol-function 'mx-machina-backend-configs) (lambda () (list config))))
        (dolist (case '(("Authentication failed SECRET-ERROR" authentication "Sign in again")
                        ("Unsupported resume SECRET-ERROR" unsupported "Repeated retries cannot")
                        ("Cannot find conversation SECRET-ERROR" history "backup")
                        ("Resume failed: inspect history SECRET-ERROR" resume "backend may have rejected")
                        ("Exited before confirming SECRET-ERROR" unconfirmed "does not identify")))
          (mx-machina--exec "UPDATE sessions SET error=? WHERE id=?" (car case) id)
          (should (eq (mx-machina-diagnostics--failure-kind (car case)) (nth 1 case)))
          (let ((report (mx-machina-diagnostics--text (mx-machina-diagnostics--collect id))))
            (should (string-match-p (nth 2 case) report))
            (should-not (string-match-p "SECRET-" report))))
        (mx-machina-diagnostics id)
        (when (bound-and-true-p evil-mode) (evil-normal-state))
        (should (eq (key-binding (kbd "R")) #'mx-machina-retry))
        (let (opened)
          (cl-letf (((symbol-function 'yes-or-no-p)
                     (lambda (prompt) (should (string-match-p "original-id" prompt)) t))
                    ((symbol-function 'mx-machina-open) (lambda (selected) (setq opened selected))))
            (call-interactively (key-binding (kbd "R"))))
          (should (equal opened id)))))))

