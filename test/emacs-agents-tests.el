    (let ((before (current-window-configuration)))
      (cl-letf (((symbol-function 'emacs-agents-start)
                 (lambda (_id) (user-error "Cannot resume"))))
        (should-error (emacs-agents-focus "test") :type 'user-error))
      (should (compare-window-configurations before (current-window-configuration)))
      (should-not (frame-parameter nil 'emacs-agents-focus-layout)))))

(ert-deftest emacs-agents-sidebar-coexists-with-another-side-window ()
  (emacs-agents-test-with-store
    (let ((buffer (generate-new-buffer "*Other sidebar test*")))
      (unwind-protect
          (let ((other (display-buffer buffer '((display-buffer-in-side-window)
                                                (side . left) (slot . 0)))))
            (emacs-agents-create "Test" repo "test")
            (emacs-agents)
            (should (window-live-p other))
            (should (eq (window-buffer other) buffer))
            (should-not (eq other (selected-window))))
        (kill-buffer buffer)))))

(ert-deftest emacs-agents-close-view-restores-editor-without-killing-drafts ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Test" repo "test"))
           (first (generate-new-buffer "*View first*"))
           (second (generate-new-buffer "*View second*")))
      (dolist (buffer (list first second))
        (with-current-buffer buffer
          (setq-local emacs-agents--managed-id id)
          (insert "unsent draft")))
      (split-window-right)
      (emacs-agents)
      (let ((before (current-window-configuration)))
        (emacs-agents--show-conversation first)
        (should (= (length (window-list)) 2))
        (emacs-agents--show-conversation second)
        (cl-letf (((symbol-function 'emacs-agents-start) (lambda (_id) second)))
          (emacs-agents-focus id))
        (should (= (length (window-list)) 1))
        (emacs-agents-close-view)
        (should (compare-window-configurations before (current-window-configuration)))
        (should-not (frame-parameter nil 'emacs-agents-conversation-layout))
        (should-not (frame-parameter nil 'emacs-agents-focus-layout))
        (dolist (buffer (list first second))
          (should (buffer-live-p buffer))
          (should-not (get-buffer-window buffer))
          (should (equal (with-current-buffer buffer (buffer-string)) "unsent draft"))))
      ;; Reopening must capture the new editing layout rather than an old one.
      (emacs-agents--select-main-window)
      (delete-other-windows)
      (emacs-agents--show-conversation first)
      (emacs-agents-close-view)
      (should (= (length (window-list)) 2)))))

(ert-deftest emacs-agents-sidebar-labels-state-and-directory-per-session ()
  (emacs-agents-test-with-store
    (let* ((other (expand-file-name "other-worktree" temporary))
           (first (emacs-agents-create "First" repo "test")))
      (emacs-agents--git repo "worktree" "add" "-b" "other" other)
      (let* ((second (emacs-agents-create "Second" other "test"))
             (run (emacs-agents--begin-run second)))
        (emacs-agents--observe second run "live" "approval" "saved")
        (emacs-agents)
        (should (equal (emacs-agents--sidebar-id) first))
        (should (string-match-p (regexp-quote "● First\n") (buffer-string)))
        (should (string-match-p (regexp-quote "● Second\n") (buffer-string)))
        (should-not (string-match-p "Dir:" (buffer-string)))
        (should (= (count-lines (point-min) (point-max)) 2))
        (emacs-agents-sidebar-next)
        (emacs-agents-sidebar-expand)
        (should (string-match-p (regexp-quote "[APPROVAL]") (buffer-string)))
        (should (string-match-p (regexp-quote (abbreviate-file-name (file-truename other))) (buffer-string)))
        (should truncate-lines)))))

(ert-deftest emacs-agents-sidebar-active-marker-follows-view-not-navigation ()
  (emacs-agents-test-with-store
    (let* ((first (emacs-agents-create "First" repo "test"))
           (second (emacs-agents-create "Second" repo "test"))
           (buffer (get-buffer-create "*Active agent test*")))
      (with-current-buffer buffer (setq-local emacs-agents--managed-id first))
      (emacs-agents--show-conversation buffer)
      (with-current-buffer "*M-x Machina Sidebar*"
        (should (equal emacs-agents--active-session first))
        (goto-char (point-min))
        (search-forward "First")
        (should (memq 'emacs-agents-active-session (get-text-property (1- (point)) 'face)))
        (should-not (string-match-p "▶" (buffer-string)))
        (goto-char (emacs-agents--sidebar-position second))
        (emacs-agents--update-active-session)
        (should (equal (emacs-agents--sidebar-id) second))
        (should (equal emacs-agents--active-session first)))
      (emacs-agents-close-view)
      (should-not emacs-agents--active-session)
      (with-current-buffer "*M-x Machina Sidebar*"
        (goto-char (point-min))
        (search-forward "First")
