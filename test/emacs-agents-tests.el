(ert-deftest emacs-agents-unread-respects-viewing-and-stale-transports ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Unread" repo "test"))
           (run (emacs-agents--begin-run id))
           (buffer (generate-new-buffer "*Unread test*"))
           (transport (emacs-agents--transport-create :buffer buffer)))
      (with-current-buffer buffer (setq-local emacs-agents--managed-id id))
      (unwind-protect
          (progn
            (puthash id (cons run transport) emacs-agents--running)
            (emacs-agents--observe id run "live" "input" "saved")
            (emacs-agents--backend-notice transport 'message nil)
            (should (emacs-agents-unread-p (emacs-agents-session id)))
            (should-not (emacs-agents--conversation-reading-p buffer))
            (emacs-agents--maybe-read-current)
            (should (emacs-agents-unread-p (emacs-agents-session id)))
            (emacs-agents--show-conversation buffer)
            (cl-letf (((symbol-function 'emacs-agents--conversation-reading-p) (lambda (_) nil)))
              (emacs-agents--maybe-read-current)
              (should (emacs-agents-unread-p (emacs-agents-session id))))
            (let ((emacs-agents-read-delay 0))
              (cl-letf (((symbol-function 'emacs-agents--conversation-reading-p) (lambda (_) t)))
                (emacs-agents--maybe-read-current)
                (should-not (emacs-agents-unread-p (emacs-agents-session id)))))
            (emacs-agents--observe id run "stopped" "unknown")
            (emacs-agents--backend-notice transport 'message nil)
            (should-not (emacs-agents-unread-p (emacs-agents-session id))))
        (remhash id emacs-agents--running)))))

