(ert-deftest emacs-agents-sidebar-preserves-selection-and-does-not-launch ()
  (emacs-agents-test-with-store
    (let* ((first (emacs-agents-create "First" repo "test"))
           (second (emacs-agents-create "Second" repo "test")))
      (emacs-agents)
      (should (eq (window-parameter nil 'window-side) 'left))
      (should buffer-read-only)
      (should (equal (emacs-agents--sidebar-id) first))
      (emacs-agents-sidebar-next)
      (should (equal (emacs-agents--read-id) second))
      (emacs-agents-sidebar-expand)
      (forward-line 2)
      (let ((position (point)) (window (selected-window)))
        (emacs-agents-refresh)
        (should (eq window (selected-window)))
        (should (= position (point)))
        (should (equal (emacs-agents--sidebar-id) second))
        (should (string-match-p "Profile: test" (buffer-string))))
      (emacs-agents-sidebar-previous)
      (should (equal (emacs-agents--sidebar-id) first))
      (emacs-agents-sidebar-previous)
      (should (equal (emacs-agents--sidebar-id) first))
      (should (zerop (hash-table-count emacs-agents--running)))
      (should-not (emacs-agents-session-run (emacs-agents-session second)))
      (should (string-match-p "2 stopped" emacs-agents--summary)))))

(ert-deftest emacs-agents-counts-honor-process-state-and-unknown-activity ()
  (let ((global-mode-string '("existing"))
        (emacs-agents-status-mode nil))
    (emacs-agents--refresh-ui
     (mapcar (lambda (pair)
               (emacs-agents--session-create :status (car pair) :activity (cdr pair)))
             '(("live" . "working") ("live" . "working") ("live" . "input")
               ("live" . "approval") ("live" . "unrecognized")
               ("starting" . "input") ("stopped" . "working")
               ("exited" . "approval") ("failed" . "input"))))
    (should (equal (substring-no-properties emacs-agents--summary)
                   " Agents: 2 working · 1 ready · 1 approval · 1 starting · 2 stopped · 1 unknown · 1 error"))
    (emacs-agents-status-mode 1)
    (emacs-agents-status-mode 1)
    (should (equal global-mode-string '("existing" emacs-agents--summary)))
    (emacs-agents-status-mode -1)
    (should (equal global-mode-string '("existing")))))

(ert-deftest emacs-agents-conversations-use-main-area-and-reuse-window ()
  (emacs-agents-test-with-store
    (let ((id (emacs-agents-create "Test" repo "test"))
          (first (generate-new-buffer "*Agent test first*"))
          (second (generate-new-buffer "*Agent test second*")))
      (dolist (buffer (list first second))
        (with-current-buffer buffer
          (setq-local emacs-agents--managed-id id)))
      (with-current-buffer first (insert "unsent draft"))
      (emacs-agents--show-conversation first)
      (let ((pane (selected-window))
            (overview (get-buffer-window "*M-x Machina Sidebar*")))
        (should-not (window-parameter pane 'window-side))
        (should (= (length (window-list)) 2))
        (emacs-agents--show-conversation second)
        (should (eq pane (selected-window)))
        (emacs-agents--select-main-window)
        (switch-to-buffer (get-buffer-create "*scratch*"))
        (delete-other-windows)
        (should (window-live-p overview))
        (should (window-live-p pane))
        (emacs-agents--show-conversation first)
        (should (equal (buffer-string) "unsent draft"))
        (let ((position (point)))
          (emacs-agents-refresh)
          (should (eq pane (selected-window)))
          (should (= position (point))))))))

(ert-deftest emacs-agents-focus-restores-layout-and-retains-draft ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Test" repo "test"))
           (conversation (generate-new-buffer "*Agent focus test*")))
      (with-current-buffer conversation
        (setq-local emacs-agents--managed-id id)
        (emacs-agents-conversation-mode 1)
        (insert "draft"))
      (emacs-agents--show-conversation conversation)
      (emacs-agents--select-main-window)
      (split-window-right)
      (select-window (get-buffer-window "*M-x Machina Sidebar*"))
      (let ((before (current-window-configuration))
            (selection (selected-window)))
        (cl-letf (((symbol-function 'emacs-agents-start) (lambda (_id) conversation)))
          (emacs-agents-focus id)
          (should (= (length (window-list)) 1))
          (should (eq (current-buffer) conversation))
          (should (eq (key-binding (kbd "C-c C-z")) #'emacs-agents-focus))
          (should (memq 'emacs-agents--summary global-mode-string))
          (goto-char (point-max))
          (insert " continued")
          (emacs-agents-refresh)
          (should (= (length (window-list)) 1))
          (emacs-agents-focus)
          (should-not (frame-parameter nil 'emacs-agents-focus-layout))
          (should (compare-window-configurations before (current-window-configuration)))
          (should (eq selection (selected-window)))
          (should (equal (with-current-buffer conversation (buffer-string)) "draft continued"))
          ;; Focusing from the conversation must work too.
          (select-window (get-buffer-window conversation))
          (emacs-agents-focus id)
          (should (= (length (window-list)) 1))
          (emacs-agents) ; Showing the overview also exits focus.
          (should (= (length (window-list)) 3))
          (should (get-buffer-window conversation)))))))

(ert-deftest emacs-agents-focus-failure-leaves-layout-intact ()
