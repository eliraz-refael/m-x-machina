(ert-deftest emacs-agents-read-delay-does-not-accumulate-between-visits ()
  (emacs-agents-test-with-store
    (let* ((first (emacs-agents-create "First" repo "test"))
           (second (emacs-agents-create "Second" repo "test"))
           (first-buffer (generate-new-buffer "*Read first*"))
           (second-buffer (generate-new-buffer "*Read second*"))
           (emacs-agents-read-delay 5)
           (now 100.0))
      (with-current-buffer first-buffer (setq-local emacs-agents--managed-id first))
      (with-current-buffer second-buffer (setq-local emacs-agents--managed-id second))
      (emacs-agents--exec "UPDATE sessions SET unread=1")
      (emacs-agents--show-conversation first-buffer)
      (cl-letf (((symbol-function 'float-time) (lambda (&rest _) now))
                ((symbol-function 'emacs-agents--conversation-reading-p) (lambda (_) t)))
        (cl-labels ((advance (seconds)
                      (dotimes (_ (* seconds 4))
                        (setq now (+ now 0.25))
                        (emacs-agents--maybe-read-current))))
          (run-hooks 'post-command-hook)
          (advance 4)
          (should (emacs-agents-unread-p (emacs-agents-session first)))
          ;; A brief visit to another agent must reset the first one's timer.
          (switch-to-buffer second-buffer)
          (run-hooks 'post-command-hook)
          (advance 1)
          (switch-to-buffer first-buffer)
          (run-hooks 'post-command-hook)
          (advance 4)
          (should (emacs-agents-unread-p (emacs-agents-session first)))
          (should (emacs-agents-unread-p (emacs-agents-session second)))
          (advance 1)
          (should-not (emacs-agents-unread-p (emacs-agents-session first)))
          (should (emacs-agents-unread-p (emacs-agents-session second)))
          ;; Explicit acknowledgment is immediate even while viewing another agent.
          (emacs-agents-mark-read second)
          (should-not (emacs-agents-unread-p (emacs-agents-session second))))))))

(ert-deftest emacs-agents-read-delay-resets-on-lost-visibility-output-and-sleep ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Read delay" repo "test"))
           (buffer (generate-new-buffer "*Read delay*"))
           (run (emacs-agents--begin-run id))
           (transport (emacs-agents--transport-create :buffer buffer))
           (emacs-agents-read-delay 3)
           (visible t)
           (now 100.0))
      (with-current-buffer buffer (setq-local emacs-agents--managed-id id))
      (unwind-protect
          (progn
            (puthash id (cons run transport) emacs-agents--running)
            (emacs-agents--observe id run "live" "input" "saved")
            (emacs-agents--backend-notice transport 'message nil)
            (emacs-agents--show-conversation buffer)
            (cl-letf (((symbol-function 'float-time) (lambda (&rest _) now))
                      ((symbol-function 'emacs-agents--conversation-reading-p) (lambda (_) visible)))
              (cl-labels ((advance (seconds)
                            (dotimes (_ (* seconds 4))
                              (setq now (+ now 0.25))
                              (emacs-agents--maybe-read-current))))
                (emacs-agents--maybe-read-current)
                (advance 2)
                ;; Scrolling away or losing focus resets, even before a tick.
                (setq visible nil)
                (emacs-agents--read-view-changed)
                (setq visible t)
                (emacs-agents--read-view-changed)
                (advance 2)
                (should (emacs-agents-unread-p (emacs-agents-session id)))
                ;; New output gets a full reading interval, even if already unread.
                (emacs-agents--backend-notice transport 'message nil)
                (emacs-agents--maybe-read-current)
                (advance 2)
                (should (emacs-agents-unread-p (emacs-agents-session id)))
                ;; An unobserved system-sleep/event-loop gap does not count.
                (setq now (+ now 60))
                (emacs-agents--maybe-read-current)
                (should (emacs-agents-unread-p (emacs-agents-session id)))
                (advance 2)
                (should (emacs-agents-unread-p (emacs-agents-session id)))
                (advance 1)
                (should-not (emacs-agents-unread-p (emacs-agents-session id)))
                (should-not emacs-agents--read-dwell))))
        (remhash id emacs-agents--running)))))

(ert-deftest emacs-agents-lock-survives-disabled-editor-lockfiles ()
