(require 'ert)
(require 'emacs-agents)

(defconst emacs-agents-test-root
  (file-name-directory (directory-file-name (file-name-directory (or load-file-name buffer-file-name)))))

(defmacro emacs-agents-test-with-store (&rest body)
  "Run BODY with an isolated registry and committed Git worktree."
  (declare (indent 0) (debug t))
  `(let* ((temporary (make-temp-file "emacs-agents-test-" t))
          (user-emacs-directory (expand-file-name "emacs/" temporary))
          (emacs-agents-directory (expand-file-name "state/" temporary))
          (emacs-agents--db nil) (emacs-agents--db-file nil)
          (emacs-agents--running (make-hash-table :test #'equal))
          (emacs-agents--timer nil)
          (emacs-agents--ui-timer nil)
          (emacs-agents--read-dwell nil)
          (emacs-agents--ui-sessions nil)
          (emacs-agents--ui-folders nil)
          (emacs-agents--active-session nil)
          (emacs-agents--conversation-buffers nil)
          (global-mode-string nil)
          (emacs-agents-status-mode nil)
          (repo (expand-file-name "worktree/" temporary)))
     (unwind-protect
         (save-window-excursion
           (make-directory repo)
           (emacs-agents--git repo "init" "-b" "main")
           (emacs-agents--git repo "-c" "user.name=Fixture" "-c" "user.email=fixture@example.invalid"
                              "-c" "commit.gpgsign=false" "commit" "--allow-empty" "-m" "Fixture")
           ,@body)
       (emacs-agents-shutdown)
       (set-frame-parameter nil 'emacs-agents-focus-layout nil)
       (set-frame-parameter nil 'emacs-agents-conversation-layout nil)
       (dolist (buffer (buffer-list))
         (when (or (member (buffer-name buffer) '("*M-x Machina*" "*M-x Machina Sidebar*" "*M-x Machina Archive*"))
                   (memq (buffer-local-value 'major-mode buffer) '(emacs-agents-diagnostics-mode emacs-agents-board-mode emacs-agents-actions-mode))
                   (buffer-local-value 'emacs-agents--managed-id buffer))
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (let ((kill-buffer-query-functions nil)) (kill-buffer buffer))))
       (delete-directory temporary t))))

(ert-deftest emacs-agents-new-worktree-persists-isolated-session ()
  (emacs-agents-test-with-store
    (let ((path (expand-file-name "agent checkout" temporary))
          (commit (emacs-agents--git repo "rev-parse" "HEAD")))
      (write-region "local work" nil (expand-file-name "draft" repo) nil 'silent)
      (let* ((id (emacs-agents-create-worktree "Harness" repo "test" "agent/harness" path "Work/Project")))
        (emacs-agents-store-close)
        (let ((session (emacs-agents-session id)))
          (should (equal (emacs-agents-session-directory session)
                         (file-name-as-directory (file-truename path))))
          (should (equal (emacs-agents-session-branch session) "agent/harness"))
          (should (equal (emacs-agents-session-project session) "worktree"))
          (should (equal (emacs-agents-session-folder session) "Work/Project"))
          (should (equal (emacs-agents-session-status session) "stopped"))
          (should-not (emacs-agents-session-run session)))
        (should (equal (emacs-agents--git path "rev-parse" "HEAD") commit))
        (should (equal (emacs-agents--git repo "branch" "--show-current") "main"))
        (should (equal (emacs-agents--git repo "status" "--porcelain") "?? draft"))
        (should-not (file-exists-p (expand-file-name "draft" path)))
        (should (zerop (hash-table-count emacs-agents--running)))))))

(ert-deftest emacs-agents-new-worktree-rejects-collisions-and-invalid-input ()
  (emacs-agents-test-with-store
    (let ((path (expand-file-name "new-worktree" temporary)))
      (dolist (branch '("main" "invalid branch" "--bad"))
        (should-error (emacs-agents-create-worktree "Test" repo "test" branch path)
                      :type 'user-error)
        (should-not (file-exists-p path)))
      (should-error (emacs-agents-create-worktree "" repo "test" "new" path) :type 'user-error)
      (should-error (emacs-agents-create-worktree "Test" repo "" "new" path) :type 'user-error)
      (make-directory path)
      (write-region "keep me" nil (expand-file-name "existing" path) nil 'silent)
      (should-error (emacs-agents-create-worktree "Test" repo "test" "new" path) :type 'user-error)
      (should (file-exists-p (expand-file-name "existing" path)))
      (should (equal (emacs-agents--git repo "branch" "--format=%(refname:short)") "main"))
      (should-not (emacs-agents-sessions)))))

(ert-deftest emacs-agents-new-worktree-save-failure-reports-retained-checkout ()
  (emacs-agents-test-with-store
    (let ((path (expand-file-name "retained" temporary)))
      (cl-letf (((symbol-function 'emacs-agents-create)
                 (lambda (&rest _) (error "Simulated registry failure"))))
        (let ((err (should-error
                    (emacs-agents-create-worktree "Test" repo "test" "agent/test" path))))
          (should (string-match-p "Worktree created at" (error-message-string err)))
          (should (string-match-p (regexp-quote path) (error-message-string err)))))
      (should (equal (cadr (emacs-agents--worktree path)) "agent/test"))
      (should-not (emacs-agents-sessions)))))

(ert-deftest emacs-agents-new-session-prompts-defer-worktree-creation ()
  (emacs-agents-test-with-store
    (dolist (create '(nil t))
      (let ((path (expand-file-name "prompted" temporary)))
        (cl-letf (((symbol-function 'read-string)
                   (lambda (prompt &rest _) (if (equal prompt "Session name: ") "Test" "agent/test")))
                  ((symbol-function 'read-directory-name)
                   (lambda (prompt &rest _)
                     (if (equal prompt "Git repository or worktree: ") repo path)))
                  ((symbol-function 'y-or-n-p) (lambda (&rest _) create))
                  ((symbol-function 'emacs-agents-backend-read-profile) (lambda () "test"))
                  ((symbol-function 'completing-read) (lambda (&rest _) "test"))
                  ((symbol-function 'emacs-agents--read-folder) (lambda () "Work")))
          (let ((args (emacs-agents--read-new-session)))
            (should (equal (nth 4 args) (and create (list "agent/test" path))))
            (should-not (file-exists-p path))
            (should-not (emacs-agents-sessions)))
          (cl-letf (((symbol-function 'emacs-agents--read-folder) (lambda () (signal 'quit nil))))
            (should (eq (condition-case nil (emacs-agents--read-new-session)
                          (quit 'cancelled)) 'cancelled)))
          (should-not (file-exists-p path))
          (should (equal (emacs-agents--git repo "branch" "--format=%(refname:short)") "main")))))))

(ert-deftest emacs-agents-profile-picker-separates-account-and-interface ()
  (let ((emacs-agents-eat-profiles
         '(((:identifier . claude-work) (:agent . "Claude") (:account . "work") (:command . ("claude")))
           ((:identifier . claude-home) (:agent . "Claude") (:account . "home") (:command . ("claude")))))
        (emacs-agents-vterm-profiles 'inherit)
        offered)
    (cl-letf (((symbol-function 'emacs-agents-agent-shell-configs)
               (lambda () '(((:identifier . claude-acp-work) (:agent . "Claude") (:account . "work")))))
              ((symbol-function 'completing-read)
               (lambda (prompt choices &rest _)
                 (push (cons prompt choices) offered)
                 (pcase prompt ("Agent: " "Claude") ("Account: " "work") ("Interface: " "vterm")))))
      (should (equal (emacs-agents-backend-read-profile) "claude-work-vterm"))
      (should (equal (sort (copy-sequence (cdr (assoc "Interface: " offered))) #'string<)
                     '("agent-shell" "eat" "vterm")))
      (should-not (map-elt (car emacs-agents-eat-profiles) :interface))
      (should (equal (map-elt (car emacs-agents-eat-profiles) :identifier) 'claude-work))
      (let ((emacs-agents-vterm-profiles '(((:identifier . claude-work)))))
        (should-error (emacs-agents-backend-configs) :type 'user-error)))))

(ert-deftest emacs-agents-eshell-is-associated-reused-and-independent ()
  (emacs-agents-test-with-store
    (let* ((first (emacs-agents-create "Harness" repo "test"))
           (second (emacs-agents-create "Migration" repo "test"))
           (initial-count (hash-table-count emacs-agents--running))
           first-buffer second-buffer)
      (unwind-protect
          (progn
            (emacs-agents)
            (setq first-buffer (emacs-agents-eshell first))
            (should (derived-mode-p 'eshell-mode))
            (should (equal (file-truename default-directory) (file-truename repo)))
            (should-not emacs-agents--managed-id)
            (insert "echo unsent draft")
            (setq second-buffer (emacs-agents-eshell second))
            (should-not (eq first-buffer second-buffer))
            (should (eq first-buffer (emacs-agents-eshell first)))
            (should (string-suffix-p "echo unsent draft" (buffer-string)))
            (should (= (length (window-list)) 2))
            (should (= initial-count (hash-table-count emacs-agents--running)))
            (should (equal (emacs-agents-session-status (emacs-agents-session first)) "stopped")))
        (dolist (buffer (list first-buffer second-buffer))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest emacs-agents-registry-persists-identity-and-recovers-status ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "O'Brien" repo "test-account"))
           (run (emacs-agents--begin-run id)))
      (emacs-agents--observe id run "live" "working" "conversation-123")
      (emacs-agents-store-close)
      (let ((session (emacs-agents-session id)))
        (should (equal (emacs-agents-session-name session) "O'Brien"))
        (should (equal (emacs-agents-session-conversation session) "conversation-123"))
        (should (equal (emacs-agents-session-profile session) "test-account"))
        (should (equal (emacs-agents-session-status session) "stopped"))
        (should (equal (emacs-agents-session-activity session) "unknown")))
      (should (equal (caar (emacs-agents--query "SELECT outcome FROM runs WHERE id=?" run)) "disconnected")))))

(ert-deftest emacs-agents-stale-and-terminal-events-cannot-resurrect-runs ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Test" repo "test"))
           (old (emacs-agents--begin-run id)))
      (emacs-agents--observe id old "stopped" "unknown" "conversation")
      (let ((new (emacs-agents--begin-run id)))
        (should-not (emacs-agents--observe id old "live" "working"))
        (emacs-agents--observe id new "failed" "unknown" nil "Resume failed")
        (should-not (emacs-agents--observe id new "live" "input"))
        (should (equal (emacs-agents-session-status (emacs-agents-session id)) "failed"))))))

(ert-deftest emacs-agents-conversation-mismatch-preserves-original ()
