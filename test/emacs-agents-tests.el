      (with-temp-buffer
        (should (= 0 (call-process
                      (expand-file-name invocation-name invocation-directory) nil t nil
                      "--batch" "-Q" "-L" (expand-file-name "lisp" emacs-agents-test-root)
                      "--eval" (prin1-to-string
                                `(progn (require 'emacs-agents-store)
                                        (setq create-lockfiles nil emacs-agents-directory ,emacs-agents-directory)
                                        (condition-case nil
                                            (progn (emacs-agents-store-open) (princ "OPENED"))
                                          (user-error (princ "BLOCKED"))))))))
        (should (equal (buffer-string) "BLOCKED")))
      (should (equal (emacs-agents-session-status (emacs-agents-session id)) "live"))
      (emacs-agents-store-close)
      (should-not (file-locked-p file)))))

