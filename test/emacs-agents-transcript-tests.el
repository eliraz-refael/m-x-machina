;;; emacs-agents-transcript-tests.el --- Transcript copy view tests -*- lexical-binding: t; -*-
(require 'emacs-agents-transcript)
(unless (boundp 'emacs-agents-test-root)
  (load (expand-file-name "emacs-agents-tests.el" (file-name-directory (or load-file-name buffer-file-name))) nil t))

(ert-deftest emacs-agents-transcript-copy-view-retains-text-and-source ()
  (emacs-agents-test-with-store
    (let* ((account (expand-file-name "account" temporary))
           (project (expand-file-name "projects/fixture" account))
           (file (expand-file-name "saved-id.jsonl" project))
           (emacs-agents-eat-profiles `(((:identifier . test-eat)
                                        (:environment . (,(concat "CLAUDE_CONFIG_DIR=" account))))))
           (id (emacs-agents-create "Reading" repo "test-eat"))
           (run (emacs-agents--begin-run id))
           (source (get-buffer-create "*Transcript source test*")))
      (make-directory project t)
      (with-temp-file file
        (dolist (row '(((type . "user") (uuid . "1") (message . ((content . "My question"))))
                       ((type . "assistant") (uuid . "2") (message . ((content . [((type . "text") (text . "First line\nSecond line"))]))))
                       ((type . "assistant") (uuid . "2") (message . ((content . [((type . "text") (text . "duplicate"))]))))
                       ((type . "user") (message . ((content . [((type . "tool_result") (content . "tool output"))]))))))
          (insert (json-encode row) "\n"))
        (insert "{\"partial\":"))
      (emacs-agents--observe id run "live" "input" "saved-id")
      (with-current-buffer source (setq-local emacs-agents--managed-id id))
      (emacs-agents--show-conversation source)
      (emacs-agents-transcript)
      (should (derived-mode-p 'emacs-agents-transcript-mode))
      (should buffer-read-only)
      (should (equal (buffer-string) "You\n\nMy question\n\nClaude\n\nFirst line\nSecond line\n\n"))
      (should-not (emacs-agents--conversation-reading-p (current-buffer)))
      (let ((transport (emacs-agents--transport-create))
            (text (buffer-string)) (position (point)))
        (puthash id (cons run transport) emacs-agents--running)
        (unwind-protect
            (progn
              (run-hook-with-args 'emacs-agents-backend-event-hook transport 'message nil)
              (should emacs-agents-transcript--stale)
              (should (equal text (buffer-string)))
              (should (= position (point)))
              (emacs-agents-transcript-refresh)
              (should-not emacs-agents-transcript--stale))
          (remhash id emacs-agents--running)))
      (when (bound-and-true-p evil-mode)
        (evil-normal-state)
        (search-forward "First line")
        (beginning-of-line)
        (execute-kbd-macro (kbd "V j y"))
        (should (string-match-p "First line\nSecond line" (current-kill 0))))
      (emacs-agents-transcript-return)
      (should (eq (current-buffer) source))
      (should (equal (emacs-agents-session-conversation (emacs-agents-session id)) "saved-id"))
      (let ((session (emacs-agents-session id))
            (emacs-agents-vterm-profiles 'inherit))
        (setf (emacs-agents-session-profile session) "test-eat-vterm")
        (should (equal (emacs-agents-transcript--file session) file))))))

(ert-deftest emacs-agents-transcript-omits-command-envelopes ()
  (emacs-agents-test-with-store
    (let ((file (expand-file-name "envelopes.jsonl" temporary)))
      (with-temp-file file
        (dolist (tag '("task-notification" "command-name" "command-message" "bash-input"
                       "bash-stdout" "local-command-stdout" "bash-stderr"))
          (insert (json-encode `((type . "user") (message . ((content . ,(format " <%s>noise</%s>" tag tag)))))) "\n"))
        (dolist (row '(((type . "user") (message . ((content . "Explain <bash-input> please"))))
                       ((type . "assistant") (message . ((content . "<bash-input>example</bash-input>"))))))
          (insert (json-encode row) "\n")))
      (should (equal (emacs-agents-transcript--text file)
                     "You\n\nExplain <bash-input> please\n\nClaude\n\n<bash-input>example</bash-input>\n\n")))))
