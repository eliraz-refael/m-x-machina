(unless (boundp 'emacs-agents-test-root)
  (load (expand-file-name "emacs-agents-tests.el" (file-name-directory (or load-file-name buffer-file-name))) nil t))
(require 'emacs-agents-diagnostics)

(defun emacs-agents-test-diagnostic-check (id label)
  "Return the diagnostic row for ID with LABEL."
  (assoc label (plist-get (emacs-agents-diagnostics--collect id) :checks)))

(ert-deftest emacs-agents-diagnostics-launch-blockers ()
  (emacs-agents-test-with-store
    (let ((id (emacs-agents-create "Broken profile" repo "test"))
          configs)
      (cl-letf (((symbol-function 'emacs-agents-backend-configs) (lambda () configs))
                ((symbol-function 'emacs-agents-backend-start) (lambda (&rest _) (ert-fail "Diagnostics launched an agent"))))
        (should (equal (cdr (emacs-agents-test-diagnostic-check id "Profile"))
                       '(blocked "test — unavailable; restore this profile in your configuration")))
        (setq configs '(((:identifier . test) (:interface . eat) (:command . ("no-such-agent-executable-92841")))))
        (should (eq (cadr (emacs-agents-test-diagnostic-check id "Executable")) 'blocked))
        (cl-letf (((symbol-function 'locate-library) (lambda (&rest _) nil))
                  ((symbol-function 'featurep) (lambda (&rest _) nil)))
          (should (eq (cadr (emacs-agents-test-diagnostic-check id "Dependency: eat")) 'blocked))))
      (cl-letf (((symbol-function 'emacs-agents-backend-configs) (lambda () (error "bad configuration SECRET"))))
        (let ((report (emacs-agents-diagnostics--text (emacs-agents-diagnostics--collect id))))
          (should (string-match-p "Configuration inspection failed" report))
          (should-not (string-match-p "SECRET" report)))))))

(ert-deftest emacs-agents-diagnostics-worktree-missing-and-mismatch ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Checkout" repo "test"))
           (before (emacs-agents--query "SELECT * FROM sessions")))
      (cl-letf (((symbol-function 'emacs-agents-backend-configs) #'ignore))
        (emacs-agents--git repo "checkout" "-b" "changed")
        (should (equal (cdr (emacs-agents-test-diagnostic-check id "Actual branch")) '(blocked "changed")))
        (should (eq (cadr (emacs-agents-test-diagnostic-check id "Worktree mismatch")) 'blocked))
        (rename-file repo (expand-file-name "relocated" temporary))
        (should (string-match-p "Directory missing" (nth 2 (emacs-agents-test-diagnostic-check id "Worktree"))))
        (should (equal before (emacs-agents--query "SELECT * FROM sessions")))))))

(ert-deftest emacs-agents-diagnostics-cold-registry-does-not-reconcile ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Saved live agent" repo "test"))
           (run (emacs-agents--begin-run id)))
      (emacs-agents--observe id run "live" "working" "durable-id")
      (emacs-agents--exec "UPDATE sessions SET unread=1 WHERE id=?" id)
      (let ((sessions (emacs-agents--query "SELECT * FROM sessions"))
            (runs (emacs-agents--query "SELECT * FROM runs")))
        (emacs-agents-store-close)
        (cl-letf (((symbol-function 'emacs-agents-backend-configs) #'ignore)
                  ((symbol-function 'emacs-agents-store-open) (lambda () (ert-fail "Diagnostics opened the manager"))))
          (should (eq (cadr (emacs-agents-test-diagnostic-check id "Observation")) 'warning))
          (should (equal (nth 2 (emacs-agents-test-diagnostic-check id "Conversation")) "durable-id"))
          (should-not emacs-agents--db)
          (let ((db (sqlite-open (expand-file-name "sessions.sqlite" emacs-agents-directory))))
            (unwind-protect
                (progn
                  (should (equal sessions (sqlite-select db "SELECT * FROM sessions")))
                  (should (equal runs (sqlite-select db "SELECT * FROM runs"))))
              (sqlite-close db))))))))

(ert-deftest emacs-agents-diagnostics-no-registry-or-migration ()
  (emacs-agents-test-with-store
    (should-error (emacs-agents-diagnostics--sessions) :type 'user-error)
    (should-not (file-exists-p emacs-agents-directory))
    (emacs-agents-create "Old schema" repo "test")
    (emacs-agents--exec "PRAGMA user_version=2")
    (should-error (emacs-agents-diagnostics--sessions) :type 'user-error)
    (should (= 2 (caar (emacs-agents--query "PRAGMA user_version"))))))

(ert-deftest emacs-agents-diagnostics-process-and-bridge-without-polling ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Terminal" repo "test"))
           (run (emacs-agents--begin-run id))
           (buffer (generate-new-buffer "*Diagnostic fixture terminal*"))
           (process (make-pipe-process :name "diagnostic-fixture" :buffer buffer :noquery t))
           (transport (emacs-agents--transport-create :buffer buffer))
           (timer (run-at-time 3600 nil #'ignore))
           (file (expand-file-name "events.jsonl" temporary)))
      (unwind-protect
          (progn
            (write-region "" nil file nil 'silent)
            (puthash id (cons run transport) emacs-agents--running)
            (with-current-buffer buffer
              (setq-local emacs-agents--backend-kind 'eat
                          emacs-agents-claude--started-at (- (float-time) 30)
                          emacs-agents-claude--timer timer
                          emacs-agents-claude--event-file file
                          emacs-agents-claude--offset 17))
            (cl-letf (((symbol-function 'emacs-agents-backend-configs)
                       (lambda () '(((:identifier . test) (:interface . eat) (:command . ("python3"))))))
                      ((symbol-function 'emacs-agents-claude--poll)
                       (lambda (&rest _) (ert-fail "Diagnostics consumed hook events"))))
              (should (eq (cadr (emacs-agents-test-diagnostic-check id "Process now")) 'ok))
              (should (eq (cadr (emacs-agents-test-diagnostic-check id "SessionStart")) 'blocked))
              (setf (emacs-agents-transport-ready transport) t)
              (should (eq (cadr (emacs-agents-test-diagnostic-check id "SessionStart")) 'ok))
              (should (eq (cadr (emacs-agents-test-diagnostic-check id "Event poller")) 'ok))
              (should (equal (nth 2 (emacs-agents-test-diagnostic-check id "Event file")) "Readable; 17 bytes consumed"))
              (cancel-timer timer)
              (should (eq (cadr (emacs-agents-test-diagnostic-check id "Event poller")) 'warning))
              (delete-file file)
              (should (eq (cadr (emacs-agents-test-diagnostic-check id "Event file")) 'warning))
              (delete-process process)
              (remhash id emacs-agents--running)
              (emacs-agents--observe id run "exited" "unknown" "durable-id")
              (should (string-match-p "Exited" (nth 2 (emacs-agents-test-diagnostic-check id "Process now"))))
              (should (string-match-p "Inactive" (nth 2 (emacs-agents-test-diagnostic-check id "Status bridge"))))))
        (remhash id emacs-agents--running)
        (cancel-timer timer)
        (when (process-live-p process) (delete-process process))
        (kill-buffer buffer)))))

(ert-deftest emacs-agents-diagnostics-ui-copy-return-preserves-agent ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Inspect me" repo "test" "Work/Project"))
           (run (emacs-agents--begin-run id))
           (source (generate-new-buffer "*Diagnostic source draft*"))
           (kill-ring nil))
      (unwind-protect
          (progn
            (emacs-agents--observe id run "failed" "unknown" "durable-id" "Authentication failed: SECRET-ERROR private prompt")
            (emacs-agents--exec "UPDATE sessions SET unread=1 WHERE id=?" id)
            (switch-to-buffer source)
            (insert "Unsent draft")
            (emacs-agents)
            (let ((before (emacs-agents--query "SELECT * FROM sessions"))
                  (runs (emacs-agents--query "SELECT * FROM runs"))
                  (windows (length (window-list))))
              (cl-letf (((symbol-function 'emacs-agents-backend-configs)
                         (lambda () '(((:identifier . test) (:interface . eat)
                                       (:command . ("python3" "--key=SECRET-ARGV"))
                                       (:environment . ("TOKEN=SECRET-ENV")))))))
                ;; Follow the same command used by i, including the interactive picker.
                (cl-letf (((symbol-function 'emacs-agents-diagnostics--read-id) (lambda () id)))
                  (call-interactively #'emacs-agents-details))
                (should (= windows (length (window-list))))
                (should (eq major-mode 'emacs-agents-diagnostics-mode))
                (when (bound-and-true-p evil-mode) (evil-normal-state))
                (should buffer-read-only)
                (should-not emacs-agents--managed-id)
                (should (string-match-p "SECRET-ERROR" (buffer-string)))
                (should (eq (key-binding (kbd "g")) #'emacs-agents-diagnostics-refresh))
                (call-interactively (key-binding (kbd "g")))
                (should (eq (key-binding (kbd "w")) #'emacs-agents-diagnostics-copy))
                (call-interactively (key-binding (kbd "w")))
                (should (string-match-p "Authentication-related failure" (car kill-ring)))
                (should (string-match-p "durable-id" (car kill-ring)))
                (should-not (string-match-p "SECRET-\\|private prompt\\|--key=" (car kill-ring)))
                (should (equal before (emacs-agents--query "SELECT * FROM sessions")))
                (should (equal runs (emacs-agents--query "SELECT * FROM runs")))
                (should (zerop (hash-table-count emacs-agents--running)))
                (should (eq (key-binding (kbd "q")) #'emacs-agents-diagnostics-return))
                (call-interactively (key-binding (kbd "q")))
                (should (eq (current-buffer) source))
                (should (equal (buffer-string) "Unsent draft")))))
        (with-current-buffer source (set-buffer-modified-p nil))
        (kill-buffer source)))))

(ert-deftest emacs-agents-diagnostics-acp-does-not-invoke-client-factory ()
  (emacs-agents-test-with-store
    (let ((id (emacs-agents-create "ACP" repo "test")))
      (emacs-agents-archive id)
      (cl-letf (((symbol-function 'emacs-agents-backend-configs)
                 (lambda () (list (list '(:identifier . test) '(:interface . agent-shell)
                                       (cons :client-maker (lambda (&rest _) (ert-fail "Created an ACP client"))))))))
        (should (eq (cadr (emacs-agents-test-diagnostic-check id "Executable")) 'warning))
        (should (string-match-p "ACP events" (nth 2 (emacs-agents-test-diagnostic-check id "Status bridge"))))
        (should (eq (cadr (emacs-agents-test-diagnostic-check id "Archive")) 'blocked))
        (should (string-match-p "Not created yet" (nth 2 (emacs-agents-test-diagnostic-check id "Conversation"))))))))

