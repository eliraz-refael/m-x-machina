;;; emacs-agents-board-tests.el --- Board navigation and state tests -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(unless (boundp 'emacs-agents-test-root)
  (load (expand-file-name "emacs-agents-tests.el" (file-name-directory (or load-file-name buffer-file-name))) nil t))
(require 'emacs-agents-board)

(ert-deftest emacs-agents-board-renders-all-states-without-side-effects ()
  (emacs-agents-test-with-store
    (let (ids)
      (dolist (state '("working" "approval" "waiting" "input" "unknown"))
        (let* ((id (emacs-agents-create (concat "Agent " state) repo "test" "Work/Panels"))
               (run (emacs-agents--begin-run id)))
          (push id ids)
          (emacs-agents--observe id run "live" state "saved")))
      (push (emacs-agents-create "Stopped" repo "test" "Work/Panels") ids)
      (emacs-agents--exec "UPDATE sessions SET unread=1")
      (let ((before (emacs-agents--query "SELECT * FROM sessions")))
        (cl-letf (((symbol-function 'emacs-agents-start) (lambda (&rest _) (ert-fail "Board launched an agent"))))
          (emacs-agents-board)
          (dolist (width '(22 56 112))
            (emacs-agents-board--render width)
            (should (= (length ids) (length emacs-agents-board--positions)))
            (should (string-match-p "Waiting  2" (buffer-string)))
            (should (string-match-p "Other  1" (buffer-string)))
            (should (string-match-p "NEW" (buffer-string)))
            (should-not emacs-agents--managed-id)
            (emacs-agents-board-next)
            (emacs-agents--maybe-read-current)
            (should (equal before (emacs-agents--query "SELECT * FROM sessions")))
            (dolist (line (split-string (buffer-string) "\n"))
              (should (<= (string-width line) width)))))))))

(ert-deftest emacs-agents-board-wraps-names-and-keeps-selection-across-status ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Migrating to Effect v4 and reviewing the Harness" repo "test" "Work/Panels/Deep/Nesting"))
           (run (emacs-agents--begin-run id)))
      (emacs-agents--observe id run "live" "working" "saved")
      (emacs-agents-board)
      (emacs-agents-board--render 28)
      (should (string-match-p "Harness" (buffer-string)))
      (should (equal id emacs-agents-board--selection))
      (emacs-agents--observe id run "live" "approval")
      (emacs-agents-refresh)
      (should (equal id emacs-agents-board--selection))
      (should (equal id (get-text-property (point) 'emacs-agents-id)))
      (should (equal (emacs-agents--read-id) id))
      (cl-letf (((symbol-function 'emacs-agents--query) (lambda (&rest _) (ert-fail "Reflow queried the registry"))))
        (emacs-agents-board--render 110))
      (should (equal id emacs-agents-board--selection)))))

(ert-deftest emacs-agents-board-folder-scope-respects-boundaries-and-archive ()
  (emacs-agents-test-with-store
    (let ((first (emacs-agents-create "Inside" repo "test" "Work"))
          (deep (emacs-agents-create "Deep" repo "test" "Work/Panels/Harness"))
          (sibling (emacs-agents-create "Sibling" repo "test" "Work Panels"))
          (archived (emacs-agents-create "Archived" repo "test" "Work")))
      (emacs-agents-archive archived)
      (emacs-agents-folder-create "Empty")
      (emacs-agents-board)
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Folder: Work")))
        (emacs-agents-board-scope))
      (should (assoc first emacs-agents-board--positions))
      (should (assoc deep emacs-agents-board--positions))
      (should-not (assoc sibling emacs-agents-board--positions))
      (should-not (assoc archived emacs-agents-board--positions))
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Folder: Empty")))
        (emacs-agents-board-scope))
      (should-not emacs-agents-board--positions)
      (should (string-match-p "No agents in this scope" (buffer-string)))
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "All folders")))
        (emacs-agents-board-scope))
      (should (= 3 (length emacs-agents-board--positions))))))

(ert-deftest emacs-agents-board-ui-open-close-restores-card-and-draft ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Open me" repo "test"))
           (source (generate-new-buffer "*Board source*"))
           (conversation (generate-new-buffer "*Board conversation*")))
      (unwind-protect
          (progn
            (switch-to-buffer source)
            (insert "Editor draft")
            (with-current-buffer conversation
              (setq-local emacs-agents--managed-id id)
              (insert "Agent draft"))
            (emacs-agents-board)
            (when (bound-and-true-p evil-mode) (evil-motion-state))
            (should (eq (key-binding (kbd "RET")) #'emacs-agents-board-open))
            (should (eq (key-binding (kbd "j")) #'emacs-agents-board-down))
            (should (eq (key-binding (kbd "f")) #'emacs-agents-board-scope))
            (let ((windows (length (window-list))))
              (cl-letf (((symbol-function 'emacs-agents-start)
                         (lambda (selected) (should (equal id selected)) conversation)))
                (call-interactively (key-binding (kbd "RET"))))
              (should (eq (current-buffer) conversation))
              (should (= windows (length (window-list))))
              (emacs-agents-close-view)
              (should (get-buffer-window "*M-x Machina Board*"))
              (with-current-buffer "*M-x Machina Board*"
                (should (equal id emacs-agents-board--selection)))
              (emacs-agents--select-main-window)
              (should (equal "Agent draft" (with-current-buffer conversation (buffer-string))))
              (should (eq (key-binding (kbd "q")) #'emacs-agents-board-return))
              (call-interactively (key-binding (kbd "q")))
              (should (eq (current-buffer) source))
              (should (equal (buffer-string) "Editor draft"))))
        (dolist (buffer (list source conversation))
          (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer))))))

(ert-deftest emacs-agents-board-navigation-and-failed-open-preserve-view ()
  (emacs-agents-test-with-store
    (let* ((first (emacs-agents-create "First" repo "test"))
           (second (emacs-agents-create "Second" repo "test"))
           (run (emacs-agents--begin-run first)))
      (emacs-agents--observe first run "live" "working" "saved")
      (emacs-agents-board)
      (emacs-agents-board--render 112)
      (should (equal first emacs-agents-board--selection))
      (emacs-agents-board-right)
      (should (equal second emacs-agents-board--selection))
      (emacs-agents-board-left)
      (should (equal first emacs-agents-board--selection))
      (let ((layout (current-window-configuration)) (point (point)))
        (cl-letf (((symbol-function 'emacs-agents-start) (lambda (&rest _) (user-error "Missing backend"))))
          (should-error (emacs-agents-board-open) :type 'user-error))
        (should (= point (point)))
        (should (compare-window-configurations layout (current-window-configuration)))))))

(ert-deftest emacs-agents-board-return-preserves-existing-conversation-close-layout ()
  (emacs-agents-test-with-store
    (let* ((id (emacs-agents-create "Existing" repo "test"))
           (source (generate-new-buffer "*Board editor layout*"))
           (conversation (generate-new-buffer "*Board existing conversation*")))
      (unwind-protect
          (progn
            (switch-to-buffer source)
            (with-current-buffer conversation (setq-local emacs-agents--managed-id id))
            (emacs-agents--show-conversation conversation)
            (let ((original (frame-parameter nil 'emacs-agents-conversation-layout)))
              (emacs-agents-board)
              (cl-letf (((symbol-function 'emacs-agents-start) (lambda (&rest _) conversation)))
                (emacs-agents-board-open))
              (emacs-agents-close-view)
              (emacs-agents--select-main-window)
              (emacs-agents-board-return)
              (should (eq (current-buffer) conversation))
              (should (eq original (frame-parameter nil 'emacs-agents-conversation-layout)))
              (emacs-agents-close-view)
              (should (get-buffer-window source))))
        (kill-buffer source) (kill-buffer conversation)))))

